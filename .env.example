RPCPROTOCOL=http
RPCHOST=127.0.0.1
RPCPORT=4000

# Frontend reads these after deployment.
NEXT_PUBLIC_GENLAYER_RPC_URL=http://127.0.0.1:4000/api
NEXT_PUBLIC_SLASH_COURT_ADDRESS=
NEXT_PUBLIC_OPERATOR_BOND_VAULT_ADDRESS=
NEXT_PUBLIC_GENLAYER_NETWORK=localnet

# Deployment overrides. Never commit private keys.
SLASHCOURT_RULEBOOK_FILE=docs/RULEBOOK.md
SLASHCOURT_EVIDENCE_DOMAINS=status.example.org,evidence.example.com
SLASHCOURT_WAIT_RETRIES=200

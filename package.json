{
  "name": "slash-court",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "npm --prefix frontend run dev --",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/transactions.test.ts tests/frontend/refresh.test.ts tests/frontend/historical.test.ts",
    "predeploy": "node scripts/clean-deploy-artifacts.mjs",
    "deploy": "genlayer deploy"
  },
  "devDependencies": {
    "genlayer-js": "^1.1.8"
  },
  "description": "SlashCourt: evidence-based settlement for bonded automation keepers."
}
